{
  "name": "warehouse-catering",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "api:dev": "dotenv -e .env -- npm run start:dev -w @app/api",
    "api:test": "npm run test -w @app/api",
    "api:test:e2e": "dotenv -e .env -- npm run test:e2e -w @app/api",
    "migration:run": "dotenv -e .env -- npm run migration:run -w @app/api",
    "migration:generate": "dotenv -e .env -- npm run migration:generate -w @app/api",
    "migration:revert": "dotenv -e .env -- npm run migration:revert -w @app/api"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.0"
  }
}
